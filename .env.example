# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GEMINI_MODEL (optional): which Gemini model Abel uses. Default: gemini-3.8-flash, then fallbacks.
# GEMINI_MODEL="gemini-3.8-flash"

# DEV_MONITOR=0 turns the read-only developer monitor at /dev-monitor.html off (it is on by default).
# It shows private cards too, so always set 0 on a hosted or shared deployment (e.g. AI Studio).

# LLM_PROVIDER: leave unset for normal runs (Gemini or an OpenAI-compatible provider like Groq).
# "mock" is a scripted stand-in for local tests only - not how the app is meant to be used.

# SUPABASE_URL and SUPABASE_SECRET_KEY (optional, legacy plumbing only): the abel_records table for
# app plumbing (chat transcripts, logs, rewards). These two alone do NOT host the three agents'
# data - that is the per-agent role URLs in the G6 section below. Loading data without
# --target file needs those role URLs; setting only these two leads to a missing-table error by
# design. If you use this, run supabase/setup.sql once in Supabase -> SQL Editor.
# In AI Studio add both under Settings → Secrets, never in code.
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_SECRET_KEY="sb_secret_..."

# ---- Use the Aalto LLM instead of Gemini (only on a laptop connected to the Aalto VPN) ----
# LLM_PROVIDER="openai"
# LLM_BASE_URL="https://llm-gateway.k8s.aalto.fi/api/v1"
# LLM_API_KEY="your Aalto key"      # never commit this; .env is ignored by git
# LLM_MODEL="Qwen/Qwen3.8-27B-FP8"
# LLM_TIMEOUT_MS="120000"           # one model call (default 120 s); a timed-out request is cancelled
# LLM_TURN_MS="150000"              # a whole chat reply

# ---- Free option that works in AI Studio: Groq (no VPN). Put these in AI Studio → Settings → Secrets ----
# LLM_PROVIDER="openai"
# LLM_BASE_URL="https://api.groq.com/openai/v1"
# LLM_API_KEY="your Groq key"
# LLM_MODEL="openai/gpt-oss-120b"
# With LLM_PROVIDER="openai" the app uses a chain: LLM_MODEL, then the other free Groq models, then Gemini
# (if GEMINI_API_KEY exists). Change the backups with LLM_FALLBACK_MODELS (comma-separated, empty = none).
# LLM_FALLBACK_MODELS="qwen/qwen3.8-27b,openai/gpt-oss-20b"
# Models that can read photos (Gemini always can): LLM_VISION_MODELS="model-a,model-b"

# ---- Model tuning (optional) ----
# LLM_GEMINI_FIRST="true"        # try Gemini before the OpenAI-compatible models (default: Gemini is the last fallback)
# LLM_MAX_CALLS="40"             # cap real provider HTTP calls per process; past the cap the agents run scripted
# LLM_AGENT_MAX_STEPS="4"        # tool-call steps an agent's model may take per run
# LLM_STEP_TIMEOUT_MS="120000"   # timeout per model call in the agent loop (default 120 s)

# ---- G6 (optional): host the three agent databases in Supabase Postgres, one role per agent ----
# Run supabase/three-agents.sql once in Supabase -> SQL Editor, set a password per role, then add
# each store's OWN connection string. An agent store only ever sees its own role; no service key
# reaches an agent path. Leave all three unset to stay on local SQLite (the default, data/arch/*.db).
# Use letters-and-digits role passwords and the session pooler host (Supabase -> Connect); the
# direct db.<project> host is unreachable on networks without IPv6.
# USER_DB_URL="postgresql://agent_user.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# CM_DB_URL="postgresql://agent_cm.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# NORDEA_DB_URL="postgresql://agent_nordea.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
