    "test": "tsx scripts/test-bank-records.ts",
    "check:feed": "tsx scripts/check-feed-csv.ts",
    "test:arch": "node scripts/run_python.mjs scripts/check_review_lines.py && tsx scripts/test-arch.ts && tsx scripts/test-migrate.ts",
    "test:adapter": "tsx scripts/test-adapter.ts",
    "test:remote": "tsx scripts/test-remote.ts",
    "check:review": "node scripts/run_python.mjs scripts/check_review_lines.py",
    "test:e2e": "tsx scripts/test-e2e.ts",
    "migrate:legacy": "tsx scripts/migrate-legacy.ts",
    "test:migrate": "tsx scripts/test-migrate.ts",
    "test:env": "tsx scripts/test-env.ts",
    "test:selftest": "tsx scripts/test-selftest.ts",
    "test:load": "node scripts/run_python.mjs scripts/test-load-merge.py"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "2.117.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "read-excel-file": "9.3.12",
    "unpdf": "1.8.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
