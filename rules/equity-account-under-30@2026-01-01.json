{
  "id": "equity-account-under-30",
  "version": "2026-01-01",
  "title": "Equity savings account: free custody under 28",
  "kind": "product",
  "validFrom": "2026-01-01",
  "validTo": null,
  "source": {
    "url": "https://www.nordea.fi/en/personal/our-services/savings-investments/investments/equity-savings-account.html",
    "checkedAt": "2026-11-23",
    "owner": "Investing product team (demo)"
  },
  "reviewDays": 180,
  "when": {
    "all": [
      {
        "fact": "age",
        "gte": 18
      },
      {
        "fact": "age",
        "lt": 28
      },
      {
        "fact": "hasEquitySavingsAccount",
        "eq": false
      },
      {
        "fact": "interestedInInvesting",
        "eq": true
      }
    ]
  },
  "ask": {
    "interestedInInvesting": "Would you like to start investing, for example in funds?"
  },
  "action": "inform",
  "regulated": true,
  "uses": [
    "abel"
  ],
  "params": {
    "ageLimit": 28
  },
  "message": "The youth custody exemption is for customers under {ageLimit}. Trading fees and other possible charges still apply. Free investment advice is separate.",
  "earns": "Fees on funds or trades if you invest through Nordea.",
  "tests": [
    {
      "name": "17 is too young",
      "today": "2026-11-20",
      "facts": {
        "age": 17,
        "hasEquitySavingsAccount": false,
        "interestedInInvesting": true
      },
      "expect": "notEligible"
    },
    {
      "name": "18 qualifies",
      "today": "2026-11-20",
      "facts": {
        "age": 18,
        "hasEquitySavingsAccount": false,
        "interestedInInvesting": true
      },
      "expect": "eligible"
    },
    {
      "name": "27 qualifies",
      "today": "2026-11-20",
      "facts": {
        "age": 27,
        "hasEquitySavingsAccount": false,
        "interestedInInvesting": true
      },
      "expect": "eligible"
    },
    {
      "name": "28 does not",
      "today": "2026-11-20",
      "facts": {
        "age": 28,
        "hasEquitySavingsAccount": false,
        "interestedInInvesting": true
      },
      "expect": "notEligible"
    },
    {
      "name": "over 30: no question asked",
      "today": "2026-11-20",
      "facts": {
        "age": 45,
        "hasEquitySavingsAccount": false
      },
      "expect": "notEligible"
    },
    {
      "name": "has one already",
      "today": "2026-11-20",
      "facts": {
        "age": 25,
        "hasEquitySavingsAccount": true,
        "interestedInInvesting": true
      },
      "expect": "notEligible"
    },
    {
      "name": "unknown interest: ask",
      "today": "2026-11-20",
      "facts": {
        "age": 25,
        "hasEquitySavingsAccount": false
      },
      "expect": "ask:interestedInInvesting"
    }
  ],
  "_note": "Student concept. Figures read on the official source on the checkedAt date; not tax or legal advice.",
  "explain": "Customers under {ageLimit} can qualify for the youth custody exemption. This adult demo only offers it to adults. Trading fees and other possible charges still apply. An equity savings account is for eligible shares, not funds or ETFs. Investment advice is a separate service, not stock-picking or portfolio management included in this account."
}
